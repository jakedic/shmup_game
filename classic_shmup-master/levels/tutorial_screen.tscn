[node name="Header" type="Label" parent="Margin/VBoxContainer/ScrollContainer/Content/ControlsSection/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54901961, 0.85098039, 1, 1)
theme_override_font_sizes/font_size = 12
text = "CONTROLS"

[node name="Body" type="RichTextLabel" parent="Margin/VBoxContainer/ScrollContainer/Content/ControlsSection/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.84705882, 0.85882353, 0.90196078, 1)
theme_override_font_sizes/normal_font_size = 9
bbcode_enabled = true
text = "[b]Move[/b]  —  Arrow Keys / WASD
[b]Shoot[/b]  —  Space or J
[b]Absorb[/b]  —  K
   Fires an absorb beam — hit an enemy with it to transform into that enemy and gain its special shot.
[b]Revert[/b]  —  L
   Instantly change back into your normal ship.
[b]Dash[/b]  —  double-tap Left or Right
   Burst-dodge out of danger.
[b]Pause[/b]  —  P"
fit_content = true
scroll_active = false

[node name="ScoringSection" type="PanelContainer" parent="Margin/VBoxContainer/ScrollContainer/Content"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_section")

[node name="VBoxContainer" type="VBoxContainer" parent="Margin/VBoxContainer/ScrollContainer/Content/ScoringSection"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Header" type="Label" parent="Margin/VBoxContainer/ScrollContainer/Content/ScoringSection/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54901961, 0.85098039, 1, 1)
theme_override_font_sizes/font_size = 12
text = "SCORING & MULTIPLIER"

[node name="Body" type="RichTextLabel" parent="Margin/VBoxContainer/ScrollContainer/Content/ScoringSection/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.84705882, 0.85882353, 0.90196078, 1)
theme_override_font_sizes/normal_font_size = 9
bbcode_enabled = true
text = "Destroying enemies earns points, shown at the bottom of the screen.

Chain your kills together to build a score multiplier — the more enemies you destroy in a row, the higher it climbs.

Go too long without a kill (about 5 seconds) and the multiplier starts dropping back down, so keep the pressure on!

Points earned = an enemy's value [b]×[/b] your current multiplier, so a high multiplier is always worth protecting."
fit_content = true
scroll_active = false

[node name="PowerupsSection" type="PanelContainer" parent="Margin/VBoxContainer/ScrollContainer/Content"]
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_section")

[node name="VBoxContainer" type="VBoxContainer" parent="Margin/VBoxContainer/ScrollContainer/Content/PowerupsSection"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Header" type="Label" parent="Margin/VBoxContainer/ScrollContainer/Content/PowerupsSection/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.54901961, 0.85098039, 1, 1)
theme_override_font_sizes/font_size = 12
text = "POWER-UPS"

[node name="Body" type="RichTextLabel" parent="Margin/VBoxContainer/ScrollContainer/Content/PowerupsSection/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.84705882, 0.85882353, 0.90196078, 1)
theme_override_font_sizes/normal_font_size = 9
bbcode_enabled = true
text = "Absorbing an enemy (see Controls above) transforms you into that enemy and gives you its unique shot.

While transformed, pressing Absorb again fires a bubble instead of absorbing — this also reverts you back to your normal ship.

If two of these bubbles collide in mid-air, they fuse together into a glowing power bubble.

Fly into a power bubble to receive a random power-up that lasts for the rest of the level — things like extra speed, piercing shots, or dash invincibility.

[b][color=#ffdb4d]You can only absorb an enemy once your score multiplier reaches 5x[/color][/b] — build your combo up first!"
fit_content = true
scroll_active = false

